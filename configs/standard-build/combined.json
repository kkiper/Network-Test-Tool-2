{
  "schema_version": 1,
  "test": "combined",
  "name": "Switch 1 + Switch 2 connected",
  "switches": [
    {
      "id": "switch1",
      "config": "switch1.json"
    },
    {
      "id": "switch2",
      "config": "switch2.json"
    }
  ],
  "interconnects": [
    {
      "note": "Switch 2 GE 1/5 runs to bulkhead 2-J4, which is cabled to bulkhead 1-J5, which runs to Switch 1 GI 1/4.",
      "a": {
        "switch": "switch1",
        "interface": "GigabitEthernet1/4"
      },
      "b": {
        "switch": "switch2",
        "interface": "GigabitEthernet1/5"
      },
      "media": "copper",
      "path": [
        "1-J5",
        "2-J4"
      ],
      "expect": {
        "link": "up",
        "duplex": "full",
        "cdp_neighbor": true
      }
    }
  ],
  "test_switch": {
    "id": "test_switch",
    "name": "Test switch",
    "note": "Plug the laptop into a spare port on the test switch. Test switch Gi1/1 to bulkhead 1-J6 is the laptop's path to the switches during the copper test.",
    "copper_test": {
      "switch": "switch1",
      "expect": {
        "speed_mbps": 1000,
        "duplex": "full"
      },
      "jacks": [
        {
          "jack": "1-J6",
          "switch_port": "GigabitEthernet1/6",
          "test_switch_port": "GigabitEthernet1/1",
          "control": true
        },
        {
          "jack": "1-J7",
          "switch_port": "GigabitEthernet2/1",
          "test_switch_port": "GigabitEthernet1/2"
        },
        {
          "jack": "1-J8",
          "switch_port": "GigabitEthernet2/2",
          "test_switch_port": "GigabitEthernet1/3"
        },
        {
          "jack": "1-J9",
          "switch_port": "GigabitEthernet2/3",
          "test_switch_port": "GigabitEthernet1/4"
        },
        {
          "jack": "1-J10",
          "switch_port": "GigabitEthernet2/4",
          "test_switch_port": "GigabitEthernet1/5"
        },
        {
          "jack": "1-J11",
          "switch_port": "GigabitEthernet2/5",
          "test_switch_port": "GigabitEthernet1/6"
        },
        {
          "jack": "1-J12",
          "switch_port": "GigabitEthernet2/6",
          "test_switch_port": "GigabitEthernet1/7"
        },
        {
          "jack": "1-J14",
          "switch_port": "GigabitEthernet2/7",
          "test_switch_port": "GigabitEthernet1/8"
        },
        {
          "jack": "1-J15",
          "switch_port": "GigabitEthernet2/8",
          "test_switch_port": "GigabitEthernet1/9"
        }
      ]
    },
    "fiber_test": {
      "switch": "switch1",
      "expect": {
        "speed_mbps": 10000,
        "etherchannel": true
      },
      "links": [
        {
          "bulkhead": "P1/S1",
          "switch_port": "TenGigabitEthernet1/1",
          "test_switch_port": "TenGigabitEthernet1/1"
        },
        {
          "bulkhead": "P2/S2",
          "switch_port": "TenGigabitEthernet1/2",
          "test_switch_port": "TenGigabitEthernet1/2"
        }
      ]
    }
  }
}
