{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jack-test.schema.json",
  "title": "Bulkhead jack test (test switch turns ports on and off)",
  "type": "object",
  "required": ["schema_version", "test", "switch", "test_switch", "jacks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "test": { "const": "jack_test" },
    "name": { "type": "string" },
    "note": { "type": "string" },
    "switch": { "$ref": "#/$defs/switch" },
    "test_switch": {
      "allOf": [{ "$ref": "#/$defs/switch" }],
      "properties": {
        "also_shut": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speed_mbps": { "type": ["integer", "null"] },
        "duplex": { "enum": ["full", "half", null] }
      }
    },
    "link_timeout_seconds": { "type": "number", "minimum": 1 },
    "jacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["jack", "switch_port", "test_switch_port"],
        "additionalProperties": false,
        "properties": {
          "jack": { "type": "string" },
          "switch_port": { "type": "string" },
          "test_switch_port": { "type": "string" },
          "control": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "switch": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "name": { "type": "string" }
      }
    }
  }
}
