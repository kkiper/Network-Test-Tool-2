{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "switch-config.schema.json",
  "title": "Switch wiring config",
  "type": "object",
  "required": [
    "schema_version",
    "switch",
    "ports"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "switch": {
      "type": "object",
      "required": [
        "id",
        "name",
        "model"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "copper": {
          "type": "object",
          "properties": {
            "expect": {
              "$ref": "#/$defs/expect"
            }
          }
        },
        "fiber": {
          "type": "object",
          "properties": {
            "expect": {
              "$ref": "#/$defs/expect"
            }
          }
        }
      }
    },
    "ip_subnets": {
      "$ref": "#/$defs/subnets"
    },
    "unlisted_ports": {
      "enum": [
        "ignore",
        "warn_if_up",
        "fail_if_up"
      ]
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": [
        "interface",
        "media",
        "connects_to"
      ],
      "additionalProperties": false,
      "properties": {
        "interface": {
          "type": "string",
          "pattern": "^(GigabitEthernet|TenGigabitEthernet)[0-9]+/[0-9]+$"
        },
        "diagram_label": {
          "type": "string"
        },
        "media": {
          "enum": [
            "copper",
            "fiber"
          ]
        },
        "connects_to": {
          "type": "object",
          "required": [
            "device",
            "kind"
          ],
          "properties": {
            "device": {
              "type": "string"
            },
            "port": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "device",
                "bulkhead",
                "switch",
                "unused"
              ]
            }
          }
        },
        "optic": {
          "type": "object",
          "properties": {
            "part_number": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "wavelength_nm": {
              "type": "number"
            },
            "fiber": {
              "enum": [
                "multimode",
                "singlemode"
              ]
            },
            "vendor": {
              "type": "string"
            },
            "compatible_with": {
              "type": "string"
            },
            "datasheet": {
              "type": "string"
            }
          }
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "expect": {
      "type": "object",
      "properties": {
        "link": {
          "enum": [
            "up",
            "optional",
            "down"
          ]
        },
        "speed_mbps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duplex": {
          "enum": [
            "full",
            "half"
          ]
        },
        "cdp_neighbor": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "ip_subnets": {
          "$ref": "#/$defs/subnets"
        },
        "mac_addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "light_levels_dbm": {
          "type": "object",
          "properties": {
            "use_module_thresholds": {
              "type": "boolean"
            },
            "tx": {
              "$ref": "#/$defs/range"
            },
            "rx": {
              "$ref": "#/$defs/range"
            }
          }
        }
      }
    },
    "subnets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9.]+/[0-9]+$"
      }
    },
    "range": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    }
  }
}
